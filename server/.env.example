# Server Configuration
PORT=8000

# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/COIN

# Groq API Key (Used as global fallback if client cookie key is not passed)
groq_api_key=gsk_your_groq_api_key_here

# Security Secrets (Generate strong random strings for production)
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_SECRET=your_master_aes256_encryption_secret_here
